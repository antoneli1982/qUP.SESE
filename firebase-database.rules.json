{
  "rules": {
    ".read": false,
    ".write": false,
    "quapAccess": {
      "users": {
        ".read": "auth != null && root.child('quapAccess/users').child(auth.uid).child('status').val() === 'approved' && root.child('quapAccess/users').child(auth.uid).child('mustChangePassword').val() === false && root.child('quapAccess/users').child(auth.uid).child('role').val() === 'senior' && (!root.child('quapAccess/users').child(auth.uid).child('passwordResetAt').exists() || auth.token.auth_time >= root.child('quapAccess/users').child(auth.uid).child('passwordResetAt').val())",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "(auth != null && auth.uid === $uid && !data.exists() && newData.child('status').val() === 'pending' && newData.child('role').val() === 'viewer' && newData.child('mustChangePassword').val() === false && !newData.child('passwordResetAt').exists() && auth.token.email === newData.child('login').val().toLowerCase() + '@users.quapsese.invalid')",
          ".validate": "newData.hasChildren(['login','status','role','mustChangePassword'])",
          "login": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9._-]{3,64}$/)"
          },
          "role": {
            ".validate": "newData.val() === 'senior' || newData.val() === 'analyst' || newData.val() === 'viewer'"
          },
          "status": {
            ".validate": "newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'blocked'"
          },
          "mustChangePassword": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          },
          "passwordResetAt": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "ferramentas": {
      "quap": {
        "matriz_competencias_v1": {
          ".read": "auth != null && root.child('quapAccess/users').child(auth.uid).child('status').val() === 'approved' && root.child('quapAccess/users').child(auth.uid).child('mustChangePassword').val() === false && (!root.child('quapAccess/users').child(auth.uid).child('passwordResetAt').exists() || auth.token.auth_time >= root.child('quapAccess/users').child(auth.uid).child('passwordResetAt').val())",
          ".write": "auth != null && root.child('quapAccess/users').child(auth.uid).child('status').val() === 'approved' && root.child('quapAccess/users').child(auth.uid).child('mustChangePassword').val() === false && (root.child('quapAccess/users').child(auth.uid).child('role').val() === 'senior' || root.child('quapAccess/users').child(auth.uid).child('role').val() === 'analyst') && (!root.child('quapAccess/users').child(auth.uid).child('passwordResetAt').exists() || auth.token.auth_time >= root.child('quapAccess/users').child(auth.uid).child('passwordResetAt').val())"
        }
      }
    }
  }
}
