{
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "database": {
    "instance": "quapsese-default-rtdb",
    "rules": "firebase-database.rules.json"
  },
  "hosting": {
    "site": "quapsese",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  }
}
